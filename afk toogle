local targetWorld = "83" -- Bisa diubah-ubah sesuka hati
local TARGET_URL = "https://github.com/afreditiyan/robloxC/raw/refs/heads/main/username"

-- Fungsi untuk mengambil list dari GitHub dengan sistem konek ulang (retry) jika gagal
local function GetTargetList()
    while true do
        local success, result = pcall(function()
            return game:HttpGet(TARGET_URL)
        end)
        
        if success and result then
            local targetList = {}
            for line in result:gmatch("[^\r\n]+") do
                local cleanedLine = line:gsub("^%s*(.-)%s*$", "%1")
                if cleanedLine ~= "" and cleanedLine:sub(1, 1) ~= "#" then
                    table.insert(targetList, cleanedLine)
                end
            end
            if #targetList > 0 then
                print("[Cultip Security] Whitelist berhasil dimuat dari GitHub!")
                return targetList
            end
        end
        
        warn("[Cultip Security] Gagal konek ke GitHub, mencoba menghubungkan ulang dalam 2 detik...")
        task.wait(2)
    end
end

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local function isWhitelisted()
    local playerName = LocalPlayer.Name
    local playerId = LocalPlayer.UserId
    local allowedList = GetTargetList()
    
    for _, allowed in ipairs(allowedList) do
        if type(allowed) == "string" and string.lower(playerName) == string.lower(allowed) then
            return true
        elseif type(allowed) == "number" and playerId == allowed then
            return true
        end
    end
    return false
end

if not isWhitelisted() then
    warn("[Cultip Security] Akses ditolak! Akun " .. LocalPlayer.Name .. " tidak terdaftar di whitelist GitHub.")
    return 
end

