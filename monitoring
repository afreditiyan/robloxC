local function SendAccountNameToDiscord()
    if DISCORD_WEBHOOK_URL == "" then return end

    local accountName = LocalPlayer.Name
    local displayName = LocalPlayer.DisplayName

    local data = {
        ["content"] = string.format("🚨 **Akun Masih Ada Elixir!**\n- Username: `%s`\n- Display Name: `%s`", accountName, displayName)
    }

    local body = HttpService:JSONEncode(data)
    local headers = {["Content-Type"] = "application/json"}
    
    local httpRequest = request or (syn and syn.request) or (http and http.request) or http_request
    if httpRequest then
        pcall(function()
            httpRequest({
                Url = DISCORD_WEBHOOK_URL,
                Method = "POST",
                Headers = headers,
                Body = body
            })
        end)
    end
end

local function CheckElixirStatus()
    local inventory = GetLiveInventory()
    if not inventory then return end
    
    local hasElixir = false

    for _, item in ipairs(inventory) do
        local uuid = item["索引"]
        local typeVal = item["类型"] or 0
        local qty = item["数量"] or 0
        
        -- Cek apakah ada item elixir valid di tas dengan jumlah > 0
        if uuid and typeVal >= 1 and typeVal <= 5 and qty > 0 then
            hasElixir = true
            break
        end
    end

    -- Kalau masih ada elixir, langsung kirim nama akun ke Discord
    if hasElixir then
        SendAccountNameToDiscord()
    end
end

-- ==========================================
-- 5. LOOP UTAMA MONITORING
-- ==========================================
task.spawn(function()
    local startTime = tick()
    local lastHerbs, lastGold = getValues()
    local checkTimer = 0
    local elixirCheckTimer = 0
    
    -- Cek elixir pertama kali saat baru masuk game
    task.wait(3)
    pcall(CheckElixirStatus)

    while true do
        local currentHerbs, currentGold = getValues()
        
        pcall(function()
            herbsInfoLabel.Text = "HERBS: " .. formatK(currentHerbs)
            goldInfoLabel.Text = "GOLD: " .. formatK(currentGold)
            
            local elapsedTime = math.floor(tick() - startTime)
            local hours = math.floor(elapsedTime / 3600)
            local minutes = math.floor((elapsedTime % 3600) / 60)
            local seconds = elapsedTime % 60
            timerLabel.Text = string.format("%02dH %02dM %02dS", hours, minutes, seconds)
        end)
        
        checkTimer = checkTimer + 1
        elixirCheckTimer = elixirCheckTimer + 1

        if checkTimer >= 60 then
            local herbsDiff = lastHerbs - currentHerbs
            local goldDiff = currentGold - lastGold
            
            if goldDiff > 0 then
                local formattedGold = formatK(goldDiff)
                modeLabel.Text = string.format("%s G/M | - FARM", formattedGold)
            elseif herbsDiff > 0 then
                local formattedHerbs = formatK(herbsDiff)
                modeLabel.Text = string.format("%s H/M | - CRAFT", formattedHerbs)
            else
                modeLabel.Text = "IDLE"
            end
            
            lastHerbs = currentHerbs
            lastGold = currentGold
            checkTimer = 0
        end

        -- Cek ulang status elixir setiap 5 menit (300 detik)
        if elixirCheckTimer >= 300 then
            pcall(CheckElixirStatus)
            elixirCheckTimer = 0
        end
        
        task.wait(1)
    end
end)
