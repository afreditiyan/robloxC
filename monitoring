                modeLabel.Text = "IDLE"
            end
            
            lastHerbs = currentHerbs
            lastGold = currentGold
            checkTimer = 0
        end

        if elixirCheckTimer >= 300 then
            pcall(CheckElixirStatus)
            elixirCheckTimer = 0
        end
        
        task.wait(1)
    end
end)
