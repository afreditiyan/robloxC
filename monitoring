        local currentHerbs, currentGold = getValues()
        
        pcall(function()
            herbsInfoLabel.Text = "HERBS: " .. formatK(currentHerbs)
            goldInfoLabel.Text = "GOLD: " .. formatK(currentGold)
            
            local elapsedTime = math.floor(tick() - startTime)
            local hours = math.floor(elapsedTime / 3600)
            local minutes = math.floor((elapsedTime % 3600) / 60)
            local seconds = elapsedTime % 60
            timerLabel.Text = string.format("%02dH %02dM %02dS", hours, minutes, seconds)
        end)
        
        checkTimer = checkTimer + 1
        elixirCheckTimer = elixirCheckTimer + 1

        if checkTimer >= 60 then
            local herbsDiff = lastHerbs - currentHerbs
            local goldDiff = currentGold - lastGold
            
