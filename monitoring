-- 0. SISTEM AUTO SERVER HOP STANDAR (STABIL)
-- ==========================================
task.spawn(function()
    task.wait(5) -- Tunggu sebentar pas masuk game pertama kali
    
    local function standardHop()
        local success, err = pcall(function()
            local servers = {}
            local cursor = ""
            
            -- Ambil list server publik game via HttpService Roblox (Lebih aman jika pakai request internal / tempat lain)
            repeat
                local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
                if cursor ~= "" then
                    url = url .. "&cursor=" .. cursor
                end
                local req = HttpService:JSONDecode(game:HttpGet(url))
                cursor = req.nextPageCursor
                for _, server in ipairs(req.data) do
                    if server.playing < server.maxPlayers and server.id ~= game.JobId then
                        table.insert(servers, server)
                    end
                end
            until not cursor or #servers > 0
            
            if #servers > 0 then
                -- Pilih server acak dari list
                local targetServer = servers[math.random(1, #servers)]
                TeleportService:TeleportToPlaceInstance(game.PlaceId, targetServer.id, LocalPlayer)
            else
                -- Kalau gak ketemu, teleport ulang biasa
                TeleportService:Teleport(game.PlaceId, LocalPlayer)
            end
        end)
        
        if not success then
            -- Fallback jika API gagal: Rejoin / Teleport standar
            TeleportService:Teleport(game.PlaceId, LocalPlayer)
        end
    end

    while true do
        local myName = string.lower(LocalPlayer.Name)
        local targetName = string.lower(TARGET_MAIN_ACCOUNT)
        
        if myName ~= targetName then
            -- KONDISI BUKAN MAINUHUY: Cek apakah mainuhuy ada di server ini
            local found = false
            for _, p in ipairs(Players:GetPlayers()) do
                if string.lower(p.Name) == targetName then
                    found = true
                    break
                end
            end
            
            -- Kalau mainuhuy TIDAK ADA di server ini, langsung pindah (hop) cari server lain
            if not found then
                print("[AutoHop] mainuhuy tidak ditemukan di server ini. Mencari server lain...")
                standardHop()
                task.wait(10)
            end
        else
            -- KONDISI AKUN UTAMA (MAINUHUY): Cari server sepi (misal total player di server <= 2 orang)
            if #Players:GetPlayers() > 2 then
                print("[AutoHop] Server terlalu ramai untuk mainuhuy. Mencari server sepi...")
                standardHop()
                task.wait(10)
            end
        end
        
        task.wait(10) -- Cek berkala setiap 10 detik
    end
end)


