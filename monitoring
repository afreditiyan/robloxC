-- 3. LOGIKA PATH & DETEKSI MODE
-- ==========================================
local function formatK(amount)
    local num = tonumber(amount) or 0
    if num >= 1000000 then
        return string.format("%.1fm", num / 1000000)
    elseif num >= 1000 then
        return string.format("%.1fk", num / 1000)
    else
        return tostring(num)
    end
end

local function getValues()
    local h, c = 0, 0
    local valFolder = LocalPlayer:FindFirstChild("值")
    if not valFolder then return h, c end
    
    for _, sub in ipairs(valFolder:GetChildren()) do
        for _, item in ipairs(sub:GetDescendants()) do
            if item:IsA("ValueBase") then
                if item.Name == "草药" then 
                    h = tonumber(item.Value) or 0
                elseif item.Name == "金币" or item.Name == "灵石" then 
                    c = tonumber(item.Value) or 0
                end
            end
        end
    end
    return h, c
end

task.spawn(function()
    local startTime = tick()
    local lastHerbs, lastGold = getValues()
    local checkTimer = 0
    
    while true do
        local currentHerbs, currentGold = getValues()
        
        pcall(function()
            herbsInfoLabel.Text = "HERBS: " .. formatK(currentHerbs)
            goldInfoLabel.Text = "GOLD: " .. formatK(currentGold)
            
            local elapsedTime = math.floor(tick() - startTime)
            local hours = math.floor(elapsedTime / 3600)
            local minutes = math.floor((elapsedTime % 3600) / 60)
            local seconds = elapsedTime % 60
            timerLabel.Text = string.format("%02dH %02dM %02dS", hours, minutes, seconds)
        end)
        
        checkTimer = checkTimer + 1
        if checkTimer >= 60 then
            local herbsDiff = lastHerbs - currentHerbs
            local goldDiff = currentGold - lastGold
            
            if goldDiff > 0 then
                local formattedGold = formatK(goldDiff)
                modeLabel.Text = string.format("%s G/M | - FARM", formattedGold)
            elseif herbsDiff > 0 then
                local formattedHerbs = formatK(herbsDiff)
                modeLabel.Text = string.format("%s H/M | - CRAFT", formattedHerbs)
            else
                modeLabel.Text = "IDLE"
            end
            
            lastHerbs = currentHerbs
            lastGold = currentGold
            checkTimer = 0
        end
        
        task.wait(1)
    end
end)
