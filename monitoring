-- 0. SISTEM AUTO-FOLLOW SERVER MAINUHUY
-- ==========================================
task.spawn(function()
    task.wait(5) -- Beri jeda 5 detik saat pertama kali join game
    
    while true do
        local myName = string.lower(LocalPlayer.Name)
        local targetName = string.lower(TARGET_MAIN_ACCOUNT)
        
        -- Hanya jalankan jika ini BUKAN akun mainuhuy
        if myName ~= targetName then
            local foundMain = false
            
            -- Cek apakah mainuhuy sudah ada di server yang sama
            for _, p in ipairs(Players:GetPlayers()) do
                if string.lower(p.Name) == targetName then
                    foundMain = true
                    break
                end
            end
            
            -- Jika mainuhuy belum ada, cari UserId-nya lalu teleport langsung ke servernya
            if not foundMain then
                print("[AutoJoin] mainuhuy belum ada di server ini. Melacak server...")
                local success, userId = pcall(function()
                    return Players:GetUserIdFromNameAsync(TARGET_MAIN_ACCOUNT)
                end)
                
                if success and userId then
                    print("[AutoJoin] Bertemu target! Melompat ke server mainuhuy...")
                    pcall(function()
                        TeleportService:TeleportToUserId(game.PlaceId, userId)
                    end)
                else
                    warn("[AutoJoin] Gagal mendeteksi UserId mainuhuy, mencoba ulang...")
                end
                
                task.wait(15)
            end
        else
            -- Jika ini akun mainuhuy, tidak usah nge-hop
            break
        end
        
        task.wait(10)
    end
end)


