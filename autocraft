-- ==========================================
-- [ 1. CONFIG UTAMA - JANGAN DI-OBFUSCATE ]
-- ==========================================
local autoCraftEnabled = false -- Ubah jadi false kalau mau dimatikan

if not autoCraftEnabled then
    print("[Cultip] autoCraftEnabled bernilai FALSE. Skrip dibatalkan.")
    return
end


-- ==========================================
-- [ 2. BAGIAN BAWAH - SILAHKAN DI-OBFUSCATE ]
-- ==========================================
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer

-- Fungsi ambil nilai herbs khusus untuk monitoring
local function getHerbsValue()
    local valFolder = LocalPlayer:FindFirstChild("值")
    if not valFolder then return 0 end
    
    for _, sub in ipairs(valFolder:GetChildren()) do
        for _, item in ipairs(sub:GetDescendants()) do
            if item:IsA("ValueBase") and item.Name == "草药" then
                return tonumber(item.Value) or 0
            end
        end
    end
    return 0
end

-- Fungsi Utama Keseluruhan (Dari Nyari Tungku Sampai Crafting)
local function startFullCraftSystem()
    if not autoCraftEnabled then return end

    -- Matikan dulu semua proses loop lama biar nggak bentrok
    _G.AutoCrafting = false
    task.wait(0.3)

    print("[Cultip] Mencari tungku pribadi dari awal...")
    
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local rootPart = character:FindFirstChild("HumanoidRootPart")

    local targetObj = nil
    if rootPart then
        local shortestDist = math.huge
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj.Name == "065炼丹炉" then
                local part = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)) or (obj:IsA("BasePart") and obj)
                if part then
                    local dist = (rootPart.Position - part.Position).Magnitude
                    if dist < shortestDist and dist < 150 then
                        shortestDist = dist
                        targetObj = obj
                    end
                end
            end
        end
    end

    if targetObj then
        local targetCFrame = nil
        if targetObj:IsA("Model") and targetObj.PrimaryPart then
            targetCFrame = targetObj.PrimaryPart.CFrame
        elseif targetObj:IsA("BasePart") then
            targetCFrame = targetObj.CFrame
        else
            local part = targetObj:FindFirstChildWhichIsA("BasePart", true)
            if part then targetCFrame = part.CFrame end
        end
        
        if targetCFrame then
            local destination = targetCFrame + Vector3.new(0, 3, 0)
            local distance = (rootPart.Position - destination.Position).Magnitude
            local travelTime = math.clamp(distance / 50, 0.2, 1.0)
            
            local tween = TweenService:Create(rootPart, TweenInfo.new(travelTime, Enum.EasingStyle.Linear), {CFrame = destination})
            tween:Play()
            tween.Completed:Wait()
            
            print("[Cultip] Sampai di tungku! Memulai Auto Craft ngebut (0.4s)...[cite: 2]")
            
            _G.AutoCrafting = true
            
            -- Task Loop Tembak Remote Craft
            task.spawn(function()
                while _G.AutoCrafting and autoCraftEnabled do
                    pcall(function()
                        ReplicatedStorage:FindFirstChild("\228\186\139\228\187\182")
                            :FindFirstChild("\229\133\172\231\148\168")
                            :FindFirstChild("\231\130\188\228\184\185")
                            :FindFirstChild("\229\136\182\228\189\156"):FireServer()
                    end)
                    task.wait(0.4) --[cite: 2]
                end
            end)
        end
    else
        warn("[Cultip] Tungku tidak ditemukan, mencoba ulang dalam 3 detik...[cite: 2]")
        task.wait(3)
        startFullCraftSystem()
    end
end

-- Jalankan sistem pertama kali
startFullCraftSystem()

-- Task Monitor Herbs 10 Detik (Kalau mandek, reset total dan execute ulang dari nyari tungku)[cite: 1]
task.spawn(function()
    while true do
        local herbsBefore = getHerbsValue()
        task.wait(10) --[cite: 1]
        
        if autoCraftEnabled then
            local herbsAfter = getHerbsValue()
            
            -- Jika herbs tidak berkurang selama 10 detik, restart total dari awal
            if herbsAfter >= herbsBefore and herbsAfter > 0 then
                print("[Cultip] Warning: Herbs tidak berkurang selama 10 detik! Melakukan execute ulang dari awal (Cari tungku)...[cite: 1]")
                
                -- Panggil ulang fungsi dari awal (otomatis matikan loop lama & cari tungku ulang)
                startFullCraftSystem()
            end
        end
    end
end)
