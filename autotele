-- Script Multi-Instance Auto Teleport 1 Device (Fixed File & Webhook)
local HttpService = game:GetService("HttpService")
local TeleportService = game:GetService("TeleportService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local HOST_ACCOUNT_NAME = "mainuhuy"
local PLACE_ID = game.PlaceId
local WEBHOOK_URL = "https://discord.com/api/webhooks/1544733323350507520/qB1NvCWDhr-i-4OmT7jSSfqPTdC4fUxL4F-l3uhqCA9P_jCj68NThfRcR8Y_2As27NJt"
local JOB_FILE_NAME = "mainuhuy_server.txt"

-- Fungsi HTTP Request kompatibel dengan Delta Android
local function httpRequest(requestData)
    if syn and syn.request then
        return syn.request(requestData)
    elseif request then
        return request(requestData)
    elseif http and http.request then
        return http.request(requestData)
    end
end

-- ================= FUNGSI AKUN UTAMA (HOST: mainuhuy) =================
if LocalPlayer.Name == HOST_ACCOUNT_NAME then
    print("[HOST] Akun utama aktif. Menyimpan JobID ke file & webhook...")
    
    task.spawn(function()
        while true do
            pcall(function()
                -- 1. Tulis ke file lokal agar akun bot dalam 1 device bisa membaca
                if writefile then
                    writefile(JOB_FILE_NAME, game.JobId)
                end
                
                -- 2. Kirim juga ke Webhook Discord untuk cadangan/notifikasi
                local payload = {
                    ["content"] = "Host JobID: `" .. game.JobId .. "`"
                }
                
                httpRequest({
                    Url = WEBHOOK_URL,
                    Method = "POST",
                    Headers = {["Content-Type"] = "application/json"},
                    Body = HttpService:JSONEncode(payload)
                })
            end)
            task.wait(10) -- Update tiap 10 detik
        end
    end)

-- ================= FUNGSI AKUN BOT (SLAVE / PENGIKUT) =================
else
    print("[SLAVE] Akun bot aktif. Memantau file server utama...")
    
    task.spawn(function()
        local lastTarget = ""
        while true do
            pcall(function()
                -- Cek apakah file lokal dari host tersedia dan bisa dibaca
                if readfile and isfile and isfile(JOB_FILE_NAME) then
                    local targetJobId = readfile(JOB_FILE_NAME)
                    
                    if targetJobId and targetJobId ~= "" and targetJobId ~= game.JobId and targetJobId ~= lastTarget then
                        if string.len(targetJobId) == 36 and string.find(targetJobId, "-") then
                            lastTarget = targetJobId
                            print("[SLAVE] Mendeteksi JobID baru: " .. targetJobId .. ". Pindah sekarang!")
                            task.wait(2)
                            TeleportService:TeleportToPlaceInstance(PLACE_ID, targetJobId, LocalPlayer)
                        end
                    end
                end
            end)
            task.wait(3) -- Cek file tiap 3 detik
        end
    end)
end
