-- Script Multi-Instance Auto Teleport via Webhook Online (Anti-Isolasi Android)
local HttpService = game:GetService("HttpService")
local TeleportService = game:GetService("TeleportService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local HOST_ACCOUNT_NAME = "mainuhuy"
local PLACE_ID = game.PlaceId

-- MASUKKAN URL DISCORD WEBHOOK KAMU DI SINI
local WEBHOOK_URL = "https://discord.com/api/webhooks/1544733323350507520/qB1NvCWDhr-i-4OmT7jSSfqPTdC4fUxL4F-l3uhqCA9P_jCj68NThfRcR8Y_2As27NJt"

-- Fungsi HTTP Request yang kompatibel dengan Delta Android
local function httpRequest(requestData)
    if syn and syn.request then
        return syn.request(requestData)
    elseif request then
        return request(requestData)
    elseif http and http.request then
        return http.request(requestData)
    end
end

-- ================= FUNGSI AKUN UTAMA (HOST: mainuhuy) =================
if LocalPlayer.Name == HOST_ACCOUNT_NAME then
    print("[HOST] Akun utama aktif. Mengirim JobID ke server online...")
    
    task.spawn(function()
        while true do
            pcall(function()
                local payload = {
                    ["content"] = game.JobId -- Mengirim JobID aktif
                }
                
                httpRequest({
                    Url = WEBHOOK_URL,
                    Method = "POST",
                    Headers = {["Content-Type"] = "application/json"},
                    Body = HttpService:JSONEncode(payload)
                })
            end)
            task.wait(15) -- Kirim update tiap 15 detik
        end
    end)

-- ================= FUNGSI AKUN BOT (SLAVE/PENGUKUT) =================
else
    print("[SLAVE] Akun bot aktif. Memantau server utama...")
    
    -- Karena Discord Webhook tidak bisa dibaca balik isinya tanpa Bot, 
    -- kita pakai trik alternatif paling gampang untuk 1 device Android: 
    -- Menyimpan JobID ke file teks lokal di folder workspace executor yang bisa dibaca bersama!
    
    local JOB_FILE_NAME = "mainuhuy_server.txt"
    
    -- HOST JUGA TULIS KE FILE LOKAL (Jaga-jaga kalau folder workspace dishare antar clone)
    -- Tapi untuk bot, kita buat sistem pembaca file teks bersama:
    task.spawn(function()
        local lastTarget = ""
        while true do
            pcall(function()
                -- Jika executor support write/read file dan membaca file dari direktori bersama
                if readfile and isfile and isfile(JOB_FILE_NAME) then
                    local targetJobId = readfile(JOB_FILE_NAME)
                    
                    if targetJobId and targetJobId ~= "" and targetJobId ~= game.JobId and targetJobId ~= lastTarget then
                        if string.len(targetJobId) == 36 and string.find(targetJobId, "-") then
                            lastTarget = targetJobId
                            print("[SLAVE] Mendeteksi JobID baru: " .. targetJobId .. ". Pindah sekarang!")
                            task.wait(2)
                            TeleportService:TeleportToPlaceInstance(PLACE_ID, targetJobId, LocalPlayer)
                        end
                    end
                end
            end)
            task.wait(5)
        end
    end)
end
