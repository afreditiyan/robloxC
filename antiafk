-- MOBILE DELTA ANTI-AFK (SPECIAL FOR PHONE / TOUCHSCREEN)
-- =========================================================

local Players = game:GetService("Players")
local VirtualUser = game:GetService("VirtualUser")
local localPlayer = Players.LocalPlayer

-- 1. Tangkap event idle game supaya tidak ke-kick server
localPlayer.Idled:Connect(function()
    pcall(function()
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.new(0, 0))
    end)
    print("[Anti-AFK Mobile] Mencegah idle kick.")
end)

-- 2. Simulasi tap/sentuh layar HP secara berkala tiap 1 menit
task.spawn(function()
    while true do
        -- Jeda waktu sekitar 55 sampai 65 detik
        task.wait(math.random(55, 65))
        
        pcall(function()
            local vu = game:GetService("VirtualUser")
            
            -- Simulasi ketukan jari di layar HP (posisi random biar aman)
            local randomX = math.random(100, 400)
            local randomY = math.random(200, 500)
            
            vu:Button1Down(Vector2.new(randomX, randomY))
            task.wait(0.15)
            vu:Button1Up(Vector2.new(randomX, randomY))
            
            print("[Anti-AFK Mobile] Sentuhan layar virtual dikirim.")
        end)
    end
end)

print("[Anti-AFK Mobile] Berhasil aktif di Delta HP! Aman ditinggal.")
