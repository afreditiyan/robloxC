-- =========================================================
-- HUMAN-LIKE ANTI-AFK SCRIPT (1 MINUTE INTERVAL)
-- =========================================================

local Players = game:GetService("Players")
local VirtualUser = game:GetService("VirtualUser")

local localPlayer = Players.LocalPlayer

-- 1. Anti-AFK Bawaan Game (Nembak event idle Roblox)
localPlayer.Idled:Connect(function()
    VirtualUser:CaptureController()
    VirtualUser:ClickButton2(Vector2.new(0, 0))
    print("[Anti-AFK] Mencegah disconnect karena idle.")
end)

-- 2. Fungsi Simulasi Gerakan & Sentuhan Layar Tiap 1 Menit
task.spawn(function()
    while true do
        -- Jeda persis sekitar 60 detik (1 menit) dengan sedikit variasi acak biar natural
        local randomWait = math.random(55, 65)
        task.wait(randomWait)

        local character = localPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")

        if humanoid and humanoid.Health > 0 then
            print("[Anti-AFK] Beraksi (Sentuh layar & gerak) untuk mencegah AFK...")

            -- Aksi A: Sentuh/Klik layar secara virtual di titik acak
            local vu = game:GetService("VirtualUser")
            vu:Button1Down(Vector2.new(math.random(100, 500), math.random(100, 500)))
            task.wait(math.random(0.1, 0.3))
            vu:Button1Up(Vector2.new(math.random(100, 500), math.random(100, 500)))

            -- Aksi B: Jalan pelan ke arah random sebentar
            local randomAngle = math.rad(math.random(0, 360))
            local randomMoveVector = Vector3.new(math.cos(randomAngle), 0, math.sin(randomAngle))
            
            humanoid:Move(randomMoveVector, true)
            
            -- Durasi jalan kaki (1 sampai 2 detik)
            task.wait(math.random(1, 2))
            
            -- Berhenti jalan
            humanoid:Move(Vector3.new(0, 0, 0), true)
        end
    end
end)

print("[Anti-AFK] Berhasil aktif! Karakter akan bergerak & klik layar tiap 1 menit.")
