local Players = game:GetService("Players")
local VirtualUser = game:GetService("VirtualUser")
local TeleportService = game:GetService("TeleportService")
local CoreGui = game:GetService("CoreGui")
local localPlayer = Players.LocalPlayer

-- 1. Tangkap event idle Roblox
localPlayer.Idled:Connect(function()
    pcall(function()
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.new(0, 0))
    end)
    print("[Anti-AFK PS99] Mencegah idle Roblox.")
end)

-- 2. Simulasi gerakan tombol kecil (Melompat / Jump) secara berkala
-- Ini trik ampuh agar PS99 tidak mengira lu AFK murni (karena karakter ikut gerak)
task.spawn(function()
    while true do
        -- Jeda acak setiap 35 sampai 45 detik
        task.wait(math.random(35, 45))
        
        pcall(function()
            local vim = game:GetService("VirtualInputManager")
            
            -- Simulasi menekan tombol Spasi (Loncat) sebentar lalu dilepas
            vim:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
            task.wait(0.1)
            vim:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
            
            print("[Anti-AFK PS99] Karakter melompat untuk bypass deteksi AFK.")
        end)
    end
end)

-- 3. Auto Reconnect (Jaga-jaga kalau tetap kena disconnect/refresh server)
task.spawn(function()
    CoreGui.ChildAdded:Connect(function(child)
        if child.Name == "ErrorPrompt" or child.Name == "RobloxPromptGui" then
            task.wait(3)
            print("[Auto Reconnect] Menyambungkan ulang ke server...")
            pcall(function()
                TeleportService:Teleport(game.PlaceId, localPlayer)
            end)
        end
    end)
end)

print("[Anti-AFK PS99] Berhasil aktif dengan metode lompat otomatis!")
