-- =========================================================
-- AUTO ACCEPT, CONFIRM & AUTO CLICK OK - MAINUHUY ONLY
-- =========================================================

if not game:IsLoaded() then 
    repeat task.wait(1) until game:IsLoaded() 
end

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- KONFIGURASI NAMA AKUN UTAMA
local TARGET_MAIN_ACCOUNT = "YUZU"

-- Cek apakah yang menjalankan skrip ini benar-benar mainuhuy
if string.lower(LocalPlayer.Name) ~= string.lower(TARGET_MAIN_ACCOUNT) then
    warn("[Security] Skrip ini khusus untuk akun " .. TARGET_MAIN_ACCOUNT .. "! Skrip dihentikan.")
    return
end

local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Remote untuk konfirmasi / setuju trade (argumen true)
local confirmTradeRemote = ReplicatedStorage:WaitForChild("\228\186\139\228\187\182")
                           :WaitForChild("\229\133\172\231\148\168")
                           :WaitForChild("\228\186\164\230\152\147")
                           :WaitForChild("\233\148\129\229\174\154\228\186\164\230\152\147")

-- Remote untuk terima undangan awal trade
local requestAcceptRemote = ReplicatedStorage:WaitForChild("\228\186\139\228\187\182")
                            :WaitForChild("\229\133\172\231\148\168")
                            :WaitForChild("\228\186\164\230\152\147")
                            :WaitForChild("\231\148\179\232\175\183\228\186\164\230\152\147")

_G.MainAccept = true

-- ==========================================
-- FITUR TAMBAHAN: AUTO CLICK OK POPUP TRADE SUCCESSFUL
-- ==========================================
task.spawn(function()
    print("[Mainuhuy] Monitor Auto-Click OK Trade Successful Aktif...")
    while _G.MainAccept do
        task.wait(0.5)
        
        pcall(function()
            -- Scan semua elemen GUI di layar player
            for _, gui in ipairs(PlayerGui:GetDescendants()) do
                if gui:IsA("TextLabel") or gui:IsA("TextButton") then
                    local textUpper = string.upper(gui.Text or "")
                    
                    -- Cek apakah teks pop-up sukses trade muncul
                    if string.find(textUpper, "TRADE SUCCESSFUL") then
                        local parentObj = gui.Parent
                        
                        -- Cari tombol OK di sekitar elemen pop-up tersebut
                        for i = 1, 3 do
                            if parentObj then
                                for _, btn in ipairs(parentObj:GetDescendants()) do
                                    if btn:IsA("TextButton") and string.upper(btn.Text or "") == "OK" then
                                        print("[Mainuhuy] Pop-up Trade Successful terdeteksi! Mengklik OK...")
                                        
                                        -- Eksekusi klik tombol OK secara otomatis menggunakan getconnections
                                        for _, conn in ipairs(getconnections(btn.MouseButton1Click)) do
                                            conn:Fire()
                                        end
                                        for _, conn in ipairs(getconnections(btn.Activated)) do
                                            conn:Fire()
                                        end
                                        
                                        task.wait(2) -- Jeda agar pop-up sempat tertutup rapi
                                    end
                                end
                                parentObj = parentObj.Parent
                            end
                        end
                    end
                end
            end
        end)
    end
end)

-- ==========================================
-- LOOP UTAMA: AUTO ACCEPT & CONFIRM TRADE
-- ==========================================
task.spawn(function()
    print("[Mainuhuy] Sistem Auto-Accept & Confirm Trade Aktif...")
    while _G.MainAccept do
        pcall(function()
            -- 1. Terima undangan trade awal
            requestAcceptRemote:FireServer()
            
            -- 2. Beri jeda 5 detik untuk memastikan semua elixir dari bot masuk
            task.wait(5)
            
            -- 3. Eksekusi konfirmasi setuju trade dengan argumen true
            local args = {
                [1] = true
            }
            confirmTradeRemote:FireServer(unpack(args))
            print("[Mainuhuy] Trade disetujui setelah jeda 5 detik!")
        end)
        
        task.wait(2) -- Jeda antar loop pengecekan trade berikutnya
    end
end)
