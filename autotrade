-- ================= CONFIGURATION =================
TARGET_TYPES = "all"            -- "all" untuk trade semua jenis elixir, atau tabel misal {1, 2}[cite: 4]
BLACKLIST_TYPES = {}            -- Tipe yang dikecualikan (kosongkan jika tidak ada)[cite: 3, 4]
TARGET_TRADE_PLAYER = "mainuhuy"-- Nama player target yang akan dikirimi request trade[cite: 1]
-- =================================================

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")

-- 1. Load Client Pill Manager
local successManager, clientPillManager = pcall(function()
    return require(ReplicatedStorage["脚本模块"]["客户端"]["工具"]["客户端丹药管理器"])
end)

if not successManager or not clientPillManager then
    warn("[AutoTrade] Gagal memuat client pill manager!")
    return
end

-- 2. Fungsi ambil inventori secara live
local function GetLiveInventory()
    local successUp, uvs = pcall(function()
        return debug.getupvalues(clientPillManager["计算可用丹药积分"])
    end)
    if successUp and uvs and uvs[1] and uvs[1]["背包"] then
        return uvs[1]["背包"]
    end
    return nil
end

-- 3. Path RemoteEvent Mass Trade & Request Trade
local tradeRemote = ReplicatedStorage
    :FindFirstChild("\228\186\139\228\187\182")
    :FindFirstChild("\229\133\172\231\148\168")
    :FindFirstChild("\228\186\164\230\152\147")
    :FindFirstChild("\230\150\176\229\162\158\228\186\164\230\152\147\231\137\169\229\147\129")

local requestTradeRemote = ReplicatedStorage
    :FindFirstChild("\228\186\139\228\187\182")
    :FindFirstChild("\229\133\172\231\148\168")
    :FindFirstChild("\228\186\164\230\152\147")
    :FindFirstChild("\231\148\179\232\175\183\228\186\164\230\152\147")

-- Fungsi bantu cek apakah angka ada di dalam tabel
local function tableContains(tbl, val)
    for _, v in ipairs(tbl) do
        if v == val then
            return true
        end
    end
    return false
end

-- Fungsi validasi utama (Target + Blacklist Check)
local function isAllowedToTrade(val)
    if tableContains(BLACKLIST_TYPES, val) then
        return false
    end

    if type(TARGET_TYPES) == "string" then
        local lowerTarget = string.lower(TARGET_TYPES)
        if lowerTarget == "all" or lowerTarget == "1-5" then
            return val >= 1 and val <= 5
        end
    elseif type(TARGET_TYPES) == "table" then
        return tableContains(TARGET_TYPES, val)
    end
    
    return false
end

-- Fungsi cek apakah masih ada elixir yang sesuai target di dalam tas
local function hasElixirInInventory()
    local inventory = GetLiveInventory()
    if not inventory then return false end
    
    for _, item in ipairs(inventory) do
        local uuid = item["索引"]
        local typeVal = item["类型"] or 0
        if uuid and isAllowedToTrade(typeVal) then
            return true
        end
    end
    return false
end

local function ProcessAllItems()
    local inventory = GetLiveInventory()
    if not inventory then
        warn("[AutoTrade] Data tas kosong atau gagal dibaca!")
        return
    end

    print("[AutoTrade] Memasukkan semua elixir ke trade...")
    
    local successCount = 0
    local skipCount = 0

    for i, item in ipairs(inventory) do
        local uuid = item["索引"]
        local typeVal = item["类型"] or 0
        local quality = item["品质"] or 0
        
        if uuid and isAllowedToTrade(typeVal) and tradeRemote then
            local args = {
                [1] = "\228\184\185\232\141\175",
                [2] = uuid,
                [3] = 99999
            }
            
            pcall(function()
                tradeRemote:FireServer(unpack(args))
            end)
            
            successCount = successCount + 1
            print(string.format("[AutoTrade] Slot [%02d] Dimasukkan -> Type: %d | Quality: %d", i, typeVal, quality))
            task.wait(0.1)
        else
            skipCount = skipCount + 1
        end
    end

    print(string.format("[AutoTrade] Selesai! Berhasil dimasukkan: %d item", successCount))
end

-- ==========================================
-- 4. OTOMATISASI REQUEST TRADE & MASUKKAN ELIXIR
-- ==========================================
task.spawn(function()
    task.wait(2)
    
    while true do
        local itemAvailable = hasElixirInInventory()
        
        if itemAvailable and requestTradeRemote then
            local targetPlayer = Players:FindFirstChild(TARGET_TRADE_PLAYER)
            if targetPlayer then
                local args = {
                    [1] = targetPlayer
                }
                
                pcall(function()
                    requestTradeRemote:FireServer(unpack(args))
                    print("[AutoTrade] Mengirim request trade ke " .. TARGET_TRADE_PLAYER .. "...")
                end)
                
                -- Tunggu sebentar agar request trade diterima/terbuka, lalu otomatis masukkan item
                task.wait(1.5)
                ProcessAllItems()
            else
                warn("[AutoTrade] Player '" .. TARGET_TRADE_PLAYER .. "' tidak ditemukan di server!")
            end
        else
            print("[AutoTrade] Elixir di tas habis. Menunggu...")
        end
        
        -- Jeda perulangan berikutnya (total jeda dari request sampai cek ulang)
        task.wait(5.5)
    end
end)
