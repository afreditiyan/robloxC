-- ================= CONFIGURATION =================
TARGET_TYPES = "all"            -- "all" untuk trade semua jenis elixir
BLACKLIST_TYPES = {}            
TARGET_TRADE_PLAYER = "mainuhuy"-- Nama akun utama

-- DAFTAR AKUN YANG DI-BLACKLIST (Gak bakal bisa jalanin skrip ini)
SCRIPT_BLACKLIST = {
    "mainuhuy", -- Contoh kalau mainuhuy gak sengaja kepasang skrip bot ini, bakal langsung mental
}
-- =================================================

if not game:IsLoaded() then 
    repeat task.wait(1) until game:IsLoaded() 
end

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- Fungsi Cek Blacklist Akun
local function isBlacklisted()
    local currentName = string.lower(LocalPlayer.Name)
    for _, blackName in ipairs(SCRIPT_BLACKLIST) do
        if currentName == string.lower(blackName) then
            return true
        end
    end
    return false
end

-- Jika akun masuk daftar blacklist, hentikan skrip total
if isBlacklisted() then
    warn("[AutoBot] ACCESS DENIED: Akun '" .. LocalPlayer.Name .."' masuk dalam blacklist skrip bot! Skrip dihentikan.")
    return
end

local ReplicatedStorage = game:GetService("ReplicatedStorage")

print("[AutoBot] Menunggu modul game termuat...")

-- 1. Load Client Pill Manager aman untuk Auto-Execute
local pillModule = ReplicatedStorage:WaitForChild("脚本模块", 999)
    :WaitForChild("客户端", 999)
    :WaitForChild("工具", 999)
    :WaitForChild("客户端丹药管理器", 999)

local clientPillManager = nil
repeat
    local successManager, result = pcall(function()
        return require(pillModule)
    end)
    if successManager and result then
        clientPillManager = result
        print("[AutoBot] Client Pill Manager siap!")
    else
        task.wait(1)
    end
until clientPillManager

-- 2. Path Remote Events
local eventFolder = ReplicatedStorage:WaitForChild("\228\186\139\228\187\182", 999)
    :WaitForChild("\229\133\172\231\148\168", 999)
    :WaitForChild("\228\186\164\230\152\147", 999)

local tradeRemote = eventFolder:WaitForChild("\230\150\176\229\162\158\228\186\164\230\152\147\231\137\169\229\147\129", 999)
local requestTradeRemote = eventFolder:WaitForChild("\231\148\179\232\175\183\228\186\164\230\152\147", 999)
local confirmTradeRemote = eventFolder:WaitForChild("\233\148\129\229\174\154\228\186\164\230\152\147", 999)

-- 3. Live Scan Inventori Tas
local function GetLiveInventory()
    local successUp, uvs = pcall(function()
        return debug.getupvalues(clientPillManager["计算可用丹药积分"])
    end)
    if successUp and uvs and uvs[1] and uvs[1]["背包"] then
        return uvs[1]["背包"]
    end
    return nil
end

local function tableContains(tbl, val)
    for _, v in ipairs(tbl) do
        if v == val then return true end
    end
    return false
end

local function isAllowedToTrade(val)
    if tableContains(BLACKLIST_TYPES, val) then return false end
    if type(TARGET_TYPES) == "string" then
        local lowerTarget = string.lower(TARGET_TYPES)
        if lowerTarget == "all" or lowerTarget == "1-5" then
            return val >= 1 and val <= 5
        end
    end
    return false
end

-- Cek apakah masih ada elixir valid di tas
local function hasElixirInInventory()
    local inventory = GetLiveInventory()
    if not inventory then return false end
    
    local count = 0
    for _, item in ipairs(inventory) do
        local uuid = item["索引"]
        local typeVal = item["类型"] or 0
        if uuid and isAllowedToTrade(typeVal) then
            count = count + 1
        end
    end
    return count > 0
end

local function ProcessAllItems()
    local inventory = GetLiveInventory()
    if not inventory then return false end

    print("[AutoBot] Memasukkan semua elixir ke trade...")
    local successCount = 0

    for _, item in ipairs(inventory) do
        local uuid = item["索引"]
        local typeVal = item["类型"] or 0
        
        if uuid and isAllowedToTrade(typeVal) then
            local args = {
                [1] = "\228\184\185\232\141\175",
                [2] = uuid,
                [3] = 99999
            }
            pcall(function()
                tradeRemote:FireServer(unpack(args))
            end)
            successCount = successCount + 1
            task.wait(0.05)
        end
    end

    return successCount > 0
end

-- 4. Loop Utama Bot (Spam request selama masih ada elixir)
task.spawn(function()
    task.wait(5)
    
    while true do
        if hasElixirInInventory() then
            local targetPlayer = Players:FindFirstChild(TARGET_TRADE_PLAYER)
            
            if targetPlayer then
                -- Spam request trade ke mainuhuy
                pcall(function()
                    requestTradeRemote:FireServer(targetPlayer)
                    print("[AutoBot] Mengirim request trade ke " .. TARGET_TRADE_PLAYER .. "...")
                end)
                
                task.wait(2)
                local sent = ProcessAllItems()
                
                if sent then
                    task.wait(1)
                    pcall(function()
                        confirmTradeRemote:FireServer(true)
                        print("[AutoBot] Item masuk, bot mengonfirmasi setuju (true)!")
                    end)
                end
            else
                warn("[AutoBot] Player " .. TARGET_TRADE_PLAYER .. " tidak ditemukan di server!")
            end
        else
            print("[AutoBot] Elixir di tas sudah habis. Bot standby...")
            task.wait(10)
        end
        
        task.wait(3)
    end
end)
