print("[AutoTrade] Semua Remote Event siap!")

-- 3. Fungsi ambil inventori secara live
local function GetLiveInventory()
    local successUp, uvs = pcall(function()
        return debug.getupvalues(clientPillManager["计算可用丹药积分"])
    end)
    if successUp and uvs and uvs[1] and uvs[1]["背包"] then
        return uvs[1]["背包"]
    end
    return nil
end

-- Fungsi bantu cek tabel
local function tableContains(tbl, val)
    for _, v in ipairs(tbl) do
        if v == val then return true end
    end
    return false
end

-- Fungsi validasi utama
local function isAllowedToTrade(val)
    if tableContains(BLACKLIST_TYPES, val) then return false end
    if type(TARGET_TYPES) == "string" then
        local lowerTarget = string.lower(TARGET_TYPES)
        if lowerTarget == "all" or lowerTarget == "1-5" then
            return val >= 1 and val <= 5
        end
    elseif type(TARGET_TYPES) == "table" then
        return tableContains(TARGET_TYPES, val)
    end
    return false
end

-- Cek apakah masih ada elixir di tas
local function hasElixirInInventory()
    local inventory = GetLiveInventory()
    if not inventory then return false end
    
    for _, item in ipairs(inventory) do
        local uuid = item["索引"]
        local typeVal = item["类型"] or 0
        if uuid and isAllowedToTrade(typeVal) then
            return true
        end
    end
    return false
end

local function ProcessAllItems()
    local inventory = GetLiveInventory()
    if not inventory then return false end

    print("[AutoTrade] Memasukkan semua elixir ke trade...")
    local successCount = 0

    for i, item in ipairs(inventory) do
        local uuid = item["索引"]
        local typeVal = item["类型"] or 0
        local quality = item["品质"] or 0
        
        if uuid and isAllowedToTrade(typeVal) then
            local args = {
                [1] = "\228\184\185\232\141\175",
                [2] = uuid,
                [3] = 99999
            }
            
            pcall(function()
                tradeRemote:FireServer(unpack(args))
            end)
            
            successCount = successCount + 1
            task.wait(0.1)
        end
    end

    print(string.format("[AutoTrade] Selesai! Total dimasukkan: %d item", successCount))
    return successCount > 0
end

-- ==========================================
-- 4. OTOMATISASI FULL (REQUEST -> PUT -> CONFIRM)
-- ==========================================
task.spawn(function()
    task.wait(5) -- Beri ekstra jeda 5 detik agar karakter spawn sempurna sebelum mulai trade
    
    while true do
        local itemAvailable = hasElixirInInventory()
        
        if itemAvailable then
            local targetPlayer = Players:FindFirstChild(TARGET_TRADE_PLAYER)
            
            if targetPlayer then
                -- 1. Kirim request trade ke mainuhuy
                local argsReq = { [1] = targetPlayer }
                pcall(function()
                    requestTradeRemote:FireServer(unpack(argsReq))
                    print("[AutoTrade] Mengirim request trade ke " .. TARGET_TRADE_PLAYER .. "...")
                end)
                
                -- Tunggu sebentar agar menu trade terbuka
                task.wait(2)
                
                -- 2. Masukkan semua elixir
                local sent = ProcessAllItems()
                
                if sent then
                    -- Beri jeda 1 detik sebelum bot menekan tombol setuju (true)
                    task.wait(1)
                    pcall(function()
                        local argsConfirm = { [1] = true }
                        confirmTradeRemote:FireServer(unpack(argsConfirm))
                        print("[AutoTrade] Semua item masuk, bot menekan tombol setuju (true)!")
                    end)
                end
            else
                warn("[AutoTrade] Player '" .. TARGET_TRADE_PLAYER .. "' tidak ditemukan di server! Menunggu...")
            end
        else
            print("[AutoTrade] Elixir di tas habis. Menunggu...")
        end
        
        task.wait(6)
    end
end)
